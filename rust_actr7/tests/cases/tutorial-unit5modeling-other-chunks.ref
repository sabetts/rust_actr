   (zero isa number visual-rep "0")
   (one isa number visual-rep "1")
   (two isa number visual-rep "2")
   (three isa number visual-rep "3")
   (1-1=0 isa math-fact arg1 one arg2 one result zero operator subtract)
   (2-1=1 isa math-fact arg1 two arg2 one result one operator subtract)
   (3-2=1 isa math-fact arg1 three arg2 two result one operator subtract)
   (1+1=2 isa math-fact arg1 one arg2 one result two operator add)
   (1+2=3 isa math-fact arg1 one arg2 two result three operator add)
