(P PRODUCTION21
  "RETRIEVE-PAST-TRIAL & RETRIEVED-A-NON-WIN - IMAGINAL-CHUNK0-2"
   !SAFE-EVAL! (NOT (EQUAL (QUOTE LOSE) (QUOTE WIN)))
   =GOAL>
       STATE RETRIEVE-PAST-TRIAL
   =IMAGINAL>
       NUM1 TWO
       NUM2 TWO
 ==>
   =IMAGINAL>
   =GOAL>
       STATE GUESS-OTHER
   +RETRIEVAL>
       IS-RESPONSE T
       KEY "s"
)
