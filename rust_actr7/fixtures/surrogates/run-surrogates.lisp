;;;; run-surrogates.lisp — regenerate the project surrogate traces.
;;;; Loaded after single-threaded ACT-R; SURROGATES_DIR points at
;;;; fixtures/models/extras/surrogates and SURROGATES_OUT at
;;;; fixtures/surrogates/traces.
(defun env (name)
  #+sbcl (sb-ext:posix-getenv name)
  #-sbcl (error "surrogate generator requires SBCL (missing env ~a)" name))

(defun load-surrogate (dir name)
  (load (concatenate 'string dir "/" name)))

(defun start-trace (out name)
  (let ((path (concatenate 'string out "/" name ".trace")))
    (when (probe-file path) (delete-file path))
    (sgp-fct (list :v path))
    path))

(defun finish-trace ()
  (sgp-fct (list :v t)))

(defun run-categorize (dir out)
  (clear-all)
  (load-surrogate dir "categorize-task.lisp")
  (load-surrogate dir "categorize-model.lisp")
  (sgp-fct (list :seed (list 100 0)))
  (reset)
  (sgp-fct (list :mp 1 :ppm 1 :egs 0 :ans nil))
  (start-trace out "categorize")
  (sgp-fct (list :trace-detail 'high :act 'high :pct t))
  (run-it)
  (finish-trace))

(defun run-zbrodoff (dir out kind)
  (clear-all)
  (load-surrogate dir (format nil "zbrodoff-retrieval-~a.lisp" kind))
  (sgp-fct (list :seed (list 100 0)))
  (reset)
  (let ((w (open-exp-window "Alpha-arithmetic Experiment" :visible nil)))
    (install-device w)
    (add-text-to-exp-window w "a + 2 = c" :x 100 :y 150))
  (sgp-fct (list :mp 1 :ppm 1 :egs 0 :ans nil))
  (start-trace out (format nil "zbrodoff-retrieval-~a" kind))
  (sgp-fct (list :trace-detail 'low))
  (run 10)
  (finish-trace))

(defun run-choice (dir out)
  (clear-all)
  (load-surrogate dir "choice-task.lisp")
  (load-surrogate dir "choice-model.lisp")
  (sgp-fct (list :seed (list 100 0)))
  (reset)
  (let ((w (open-exp-window "Choice Experiment" :visible nil)))
    (install-device w))
  (start-trace out "choice-surrogate")
  (sgp-fct (list :trace-detail 'medium))
  (run-it)
  (finish-trace))

(defun surrogates-main ()
  (let ((dir (env "SURROGATES_DIR"))
        (out (env "SURROGATES_OUT")))
    (unless (and dir out)
      (error "SURROGATES_DIR and SURROGATES_OUT must be set"))
    (ensure-directories-exist (concatenate 'string out "/"))
    (run-categorize dir out)
    (run-zbrodoff dir out "hit")
    (run-zbrodoff dir out "miss")
    (run-choice dir out)
    (format t "SURROGATES-RESULT OK~%")))
