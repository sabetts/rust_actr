;; Project-authored surrogate task for tests/surrogates.rs.
;; Adapted from ACT-R:tutorial;lisp;categorize.lisp (public ACT-R source).
(defparameter *slots* '(eh es nl mh))
(defun size-similarities (a b)
  (when (numberp b)
    (if (eq a 'small)
        (if (< b -0.45) 0.0 (if (< b 0.45) -0.5 -1.0))
      (if (eq a 'medium)
          (if (and (>= b -0.45) (<= b 0.45)) 0.0 -0.5)
        (if (eq a 'large)
            (if (> b 0.45) 0.0 (if (> b -0.45) -0.5 -1.0))
          nil)))))
(add-act-r-command "size-similarities" 'size-similarities "Categorize surrogate similarity hook.")
(defun present-attribute (name value)
  (goal-focus-fct (list 'isa 'goal 'state 'add-attribute 'name name 'value value))
  (run 20))
(defun run-it ()
  (present-attribute 'eh 1)
  (present-attribute 'es -1)
  (present-attribute 'nl -1)
  (present-attribute 'mh -1)
  (goal-focus-fct '(isa goal state categorize))
  (run 20))
