(load-act-r-model "ACT-R:test-models;models;base-level-safety-check.lisp")

(defun run-it ()
  (reset)
  (sgp :ol nil)
  (run-test)
  (reset)
  (sgp :ol t)
  (run-test)
  (reset)
  (sgp :ol 1)
  (run-test)
  (reset)
  (sgp :ol 3)
  (run-test))

(defun run-test ()
  (format *out-file* "--------------------------~%")
  (add-dm (a))
  (module-request 'retrieval (define-chunk-spec))
  (run-full-time 50)
  (merge-dm (b))
  (module-request 'retrieval (define-chunk-spec))
  (run-full-time 150)
  (merge-dm (c))
  (run-full-time 30)
  (module-request 'retrieval (define-chunk-spec))
  (run-full-time 10)
  (merge-dm (d))
  (run-full-time 5)
  (module-request 'retrieval (define-chunk-spec))
  (run-full-time 1)
  (merge-dm (e))
  (run-full-time 50)
  (module-request 'retrieval (define-chunk-spec))
  (run-full-time 100))

