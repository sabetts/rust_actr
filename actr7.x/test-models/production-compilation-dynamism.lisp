
(defun run-it ()
  (dotimes (i 126)
    (goal-focus g)
    (mod-focus-fct (list 'test-num i))
    (set-buffer-chunk 'imaginal 'test)
    (schedule-mod-buffer-chunk 'imaginal (list 'test-num i) 0 :priority 10)
    (run .1)
    (run-full-time 5))
  (dotimes (i 2)
    (goal-focus g)
    (mod-focus-fct (list 'test-num (+ i 126) 'value 1))
    (set-buffer-chunk 'imaginal 'test)
    (schedule-mod-buffer-chunk 'imaginal (list 'test-num (+ i 126)) 0 :priority 10)
    (run .1)
    (run-full-time 5))
  (dotimes (i 17)
    (goal-focus g)
    (mod-focus-fct (list 'test-num (+ i 128)))
    (set-buffer-chunk 'imaginal 'test)
    (schedule-mod-buffer-chunk 'imaginal (list 'test-num (+ i 128)) 0 :priority 10)
    (run .1)
    (run-full-time 5))
  (dotimes (i 2)
    (goal-focus g)
    (mod-focus-fct (list 'test-num (+ i 145)))
    (clear-buffer 'imaginal)
    (run .1)
    (run-full-time 5))
  ;; now reverse the goal and imaginal buffers 
  
  (dotimes (i 126)
    (set-buffer-chunk 'imaginal 'g)
    (mod-buffer-chunk 'imaginal (list 'test-num i))
    (set-buffer-chunk 'goal 'test)
    (schedule-mod-buffer-chunk 'goal (list 'test-num i) 0 :priority 10)
    (run .3)
    (run-full-time 5))
  
  (dotimes (i 2)
    (set-buffer-chunk 'imaginal 'g)
    (mod-buffer-chunk 'imaginal (list 'test-num (+ i 126) 'value 1))
    (set-buffer-chunk 'goal 'test)
    (schedule-mod-buffer-chunk 'goal (list 'test-num (+ i 126)) 0 :priority 10)
    (run .3)
    (run-full-time 5))
  (dotimes (i 17)
    (set-buffer-chunk 'imaginal 'g)
    (mod-buffer-chunk 'imaginal (list 'test-num (+ i 128)))
    (set-buffer-chunk 'goal 'test)
    (schedule-mod-buffer-chunk 'goal (list 'test-num (+ i 128)) 0 :priority 10)
    (run .3)
    (run-full-time 5))
  (dotimes (i 2)
    (set-buffer-chunk 'imaginal 'g)
    (mod-buffer-chunk 'imaginal (list 'test-num (+ i 145)))
    (set-buffer-chunk 'goal 'test)
    (schedule-mod-buffer-chunk 'goal (list 'test-num (+ i 128)) 0 :priority 10)
    (run .3)
    (run-full-time 5))
  
  ;; some miscellaneous cases
  (dotimes (i 2)
    (set-buffer-chunk 'imaginal 'test)
    (mod-buffer-chunk 'imaginal (list 'test-num (+ i 200)))
    (set-buffer-chunk 'goal 'g)
    (schedule-mod-buffer-chunk 'goal (list 'test-num (+ i 200)) 0 :priority 10)
    (run .3)
    (run-full-time 5))
  
  )

(load-act-r-model "ACT-R:test-models;models;production-compilation-dynamism.lisp")
